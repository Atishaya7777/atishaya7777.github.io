---
import routes from '../../global/routes';
import DarkModeToggle from '../DarkModeToggle/DarkModeToggle';

const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');

const navItems = [
	{ label: 'Works', path: routes.works },
	{ label: 'Research', path: routes.research },
	{ label: 'Blog', path: routes.blog },
	{ label: 'Contact', path: routes.contact },
];
---

<header class="sticky top-0 z-50 bg-background-base/90 dark:bg-primary-950/90 backdrop-blur-sm border-b border-primary-100 dark:border-primary-300 transition-colors duration-300">
	<div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
		<!-- Name / Logo -->
		<a
			href={routes.home}
			class="font-yesteryear text-2xl text-primary-800 dark:text-background-200 hover:text-tertiary-600 dark:hover:text-tertiary-400 transition-colors"
		>
			Atishaya Maharjan
		</a>

		<!-- Desktop nav -->
		<nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
			{navItems.map((item) => {
				const isActive = currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path));
				return (
<a
						href={item.path}
						class={`text-sm tracking-wide transition-colors duration-200 ${
isActive
? 'text-primary-900 dark:text-background-100 border-b border-primary-800 dark:border-background-200 pb-0.5'
: 'text-primary-600 dark:text-background-400 hover:text-primary-900 dark:hover:text-background-100'
}`}
					>
						{item.label}
					</a>
				);
			})}
			<a
				href="/assets/resume.pdf"
				target="_blank"
				rel="noopener noreferrer"
				class="text-sm tracking-wide text-tertiary-600 dark:text-tertiary-400 hover:text-tertiary-800 dark:hover:text-tertiary-300 transition-colors duration-200"
			>
				Résumé ↗
			</a>
			<DarkModeToggle client:load />
		</nav>

		<!-- Mobile controls -->
		<div class="flex items-center gap-3 md:hidden">
			<DarkModeToggle client:load />
			<button
				id="mobile-menu-btn"
				class="text-primary-700 dark:text-background-300 hover:text-primary-900 dark:hover:text-background-100 transition-colors"
				aria-label="Toggle menu"
				aria-expanded="false"
			>
				<svg class="w-5 h-5 menu-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
				<svg class="w-5 h-5 menu-close hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile menu -->
	<nav
		id="mobile-menu"
		class="hidden md:hidden border-t border-primary-100 dark:border-primary-300 bg-background-base dark:bg-primary-950"
		aria-label="Mobile navigation"
	>
		<div class="max-w-5xl mx-auto px-6 py-4 flex flex-col gap-4">
			{navItems.map((item) => {
				const isActive = currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path));
				return (
<a
						href={item.path}
						class={`text-sm tracking-wide transition-colors ${
isActive
? 'text-primary-900 dark:text-background-100'
: 'text-primary-600 dark:text-background-400 hover:text-primary-900 dark:hover:text-background-100'
}`}
					>
						{item.label}
					</a>
				);
			})}
			<a
				href="/assets/resume.pdf"
				target="_blank"
				rel="noopener noreferrer"
				class="text-sm tracking-wide text-tertiary-600 dark:text-tertiary-400 hover:text-tertiary-800 dark:hover:text-tertiary-300 transition-colors"
			>
				Résumé ↗
			</a>
		</div>
	</nav>
</header>

<script>
	const btn = document.getElementById('mobile-menu-btn');
	const menu = document.getElementById('mobile-menu');
	const openIcon = btn?.querySelector('.menu-open');
	const closeIcon = btn?.querySelector('.menu-close');

	btn?.addEventListener('click', () => {
		const expanded = btn.getAttribute('aria-expanded') === 'true';
		btn.setAttribute('aria-expanded', String(!expanded));
		menu?.classList.toggle('hidden');
		openIcon?.classList.toggle('hidden');
		closeIcon?.classList.toggle('hidden');
	});

	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		if (!btn?.contains(target) && !menu?.contains(target)) {
			menu?.classList.add('hidden');
			btn?.setAttribute('aria-expanded', 'false');
			openIcon?.classList.remove('hidden');
			closeIcon?.classList.add('hidden');
		}
	});

	window.addEventListener('resize', () => {
		if (window.innerWidth >= 768) {
			menu?.classList.add('hidden');
			btn?.setAttribute('aria-expanded', 'false');
			openIcon?.classList.remove('hidden');
			closeIcon?.classList.add('hidden');
		}
	});
</script>
