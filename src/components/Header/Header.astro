---
import routes from '../../global/routes';
import DarkModeToggle from '../DarkModeToggle/DarkModeToggle';
import Seal from '../Seal/Seal.astro';

const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');

const navItems = [
	{ label: 'Works', path: routes.works },
	{ label: 'Research', path: routes.research },
	{ label: 'Blog', path: routes.blog },
	{ label: 'Contact', path: routes.contact },
];
---

<header class="sticky top-0 z-50 bg-paper-100/95 dark:bg-paper-900/95 backdrop-blur-sm border-b border-rule dark:border-rule-dark transition-colors duration-300">
	<div class="max-w-4xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
		<!-- Wordmark: seal + spaced caps with raised plum initials -->
		<a
			href={routes.home}
			class="group flex items-center gap-2.5 whitespace-nowrap"
		>
			<Seal class="w-7 h-7 sm:w-8 sm:h-8 shrink-0 text-ink-900 dark:text-ink-100 group-hover:text-accent-600 dark:group-hover:text-accent-300 transition-colors" />
			<span
				aria-hidden="true"
				class="font-display text-[13px] sm:text-sm tracking-[0.18em] uppercase leading-none text-ink-900 dark:text-ink-100 group-hover:text-accent-700 dark:group-hover:text-accent-200 transition-colors"
			>
				<span class="text-[1.45em] font-medium text-accent-600 dark:text-accent-300">A</span>tishaya
				<span class="text-[1.45em] font-medium text-accent-600 dark:text-accent-300">M</span>aharjan
			</span>
			<span class="sr-only">Atishaya Maharjan — home</span>
		</a>

		<!-- Desktop nav -->
		<nav class="hidden md:flex items-center gap-5" aria-label="Main navigation">
			{navItems.map((item) => {
				const isActive = currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path));
				return (
					<a
						href={item.path}
						aria-current={isActive ? 'page' : undefined}
						class={`text-xs tracking-[0.12em] uppercase transition-colors duration-200 ${
							isActive
								? 'text-accent-600 dark:text-accent-300 border-b border-accent-600 dark:border-accent-300 pb-0.5'
								: 'text-ink-500 dark:text-ink-300 hover:text-ink-900 dark:hover:text-ink-100'
						}`}
					>
						{item.label}
					</a>
				);
			})}
			<a
				href="/assets/atishaya_research_resume.pdf"
				target="_blank"
				rel="noopener noreferrer"
				title="Research CV — for academic audiences"
				class="text-xs tracking-[0.12em] uppercase text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors duration-200"
			>
				CV&nbsp;↗
			</a>
			<a
				href="/assets/atishaya_swe_resume.pdf"
				target="_blank"
				rel="noopener noreferrer"
				title="Industry résumé — for software engineering roles"
				class="text-xs tracking-[0.12em] uppercase text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors duration-200"
			>
				Résumé&nbsp;↗
			</a>
			<DarkModeToggle client:load />
		</nav>

		<!-- Mobile controls -->
		<div class="flex items-center gap-3 md:hidden">
			<DarkModeToggle client:load />
			<button
				id="mobile-menu-btn"
				type="button"
				class="text-ink-700 dark:text-ink-200 hover:text-ink-900 dark:hover:text-ink-100 transition-colors"
				aria-label="Toggle menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg class="w-5 h-5 menu-open" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
				<svg class="w-5 h-5 menu-close hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile menu -->
	<nav
		id="mobile-menu"
		class="hidden md:hidden border-t border-rule dark:border-rule-dark bg-paper-100 dark:bg-paper-900"
		aria-label="Mobile navigation"
	>
		<div class="max-w-3xl mx-auto px-6 py-4 flex flex-col gap-4">
			{navItems.map((item) => {
				const isActive = currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path));
				return (
					<a
						href={item.path}
						aria-current={isActive ? 'page' : undefined}
						class={`text-xs tracking-[0.12em] uppercase transition-colors ${
							isActive
								? 'text-accent-600 dark:text-accent-300'
								: 'text-ink-500 dark:text-ink-300 hover:text-ink-900 dark:hover:text-ink-100'
						}`}
					>
						{item.label}
					</a>
				);
			})}
			<a
				href="/assets/atishaya_research_resume.pdf"
				target="_blank"
				rel="noopener noreferrer"
				class="text-xs tracking-[0.12em] uppercase text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors"
			>
				Research CV ↗
			</a>
			<a
				href="/assets/atishaya_swe_resume.pdf"
				target="_blank"
				rel="noopener noreferrer"
				class="text-xs tracking-[0.12em] uppercase text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors"
			>
				Industry Résumé ↗
			</a>
		</div>
	</nav>
</header>

<script>
	const btn = document.getElementById('mobile-menu-btn');
	const menu = document.getElementById('mobile-menu');
	const openIcon = btn?.querySelector('.menu-open');
	const closeIcon = btn?.querySelector('.menu-close');

	btn?.addEventListener('click', () => {
		const expanded = btn.getAttribute('aria-expanded') === 'true';
		btn.setAttribute('aria-expanded', String(!expanded));
		menu?.classList.toggle('hidden');
		openIcon?.classList.toggle('hidden');
		closeIcon?.classList.toggle('hidden');
	});

	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		if (!btn?.contains(target) && !menu?.contains(target)) {
			menu?.classList.add('hidden');
			btn?.setAttribute('aria-expanded', 'false');
			openIcon?.classList.remove('hidden');
			closeIcon?.classList.add('hidden');
		}
	});

	window.addEventListener('resize', () => {
		if (window.innerWidth >= 768) {
			menu?.classList.add('hidden');
			btn?.setAttribute('aria-expanded', 'false');
			openIcon?.classList.remove('hidden');
			closeIcon?.classList.add('hidden');
		}
	});
</script>
