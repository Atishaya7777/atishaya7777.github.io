---
import Seal from '../Seal/Seal.astro';
---

<footer class="border-t border-rule dark:border-rule-dark bg-paper-100 dark:bg-paper-900 transition-colors duration-300">
	<div class="max-w-3xl mx-auto px-6 py-10 text-center space-y-4">
		<div class="flex justify-center">
			<Seal class="w-10 h-10 text-ink-500 dark:text-ink-300" />
		</div>

		<div class="flex items-center justify-center gap-6">
			<a
				href="mailto:atishaya7777@gmail.com"
				class="text-xs tracking-[0.12em] uppercase text-ink-500 dark:text-ink-300 hover:text-accent-600 dark:hover:text-accent-300 transition-colors"
			>
				Email
			</a>
			<a
				href="https://github.com/Atishaya7777"
				target="_blank"
				rel="noopener noreferrer"
				class="text-xs tracking-[0.12em] uppercase text-ink-500 dark:text-ink-300 hover:text-accent-600 dark:hover:text-accent-300 transition-colors"
			>
				GitHub
			</a>
			<a
				href="https://www.linkedin.com/in/atishaya-maharjan07"
				target="_blank"
				rel="noopener noreferrer"
				class="text-xs tracking-[0.12em] uppercase text-ink-500 dark:text-ink-300 hover:text-accent-600 dark:hover:text-accent-300 transition-colors"
			>
				LinkedIn
			</a>
		</div>

		<p class="text-xs text-ink-400 dark:text-ink-300">
			© {new Date().getFullYear()} Atishaya Maharjan · Winnipeg, Canada
		</p>
		<p class="text-xs text-ink-400 dark:text-ink-300 italic font-display">
			Set in Cormorant Garamond &amp; Source Serif.
		</p>
	</div>
</footer>
