---
// Only show the banner in production — /v1/ doesn't exist in the dev server
const isProd = import.meta.env.PROD;
---
{isProd && <div
  id="version-banner"
  class="w-full bg-paper-200 dark:bg-paper-800 text-ink-700 dark:text-ink-200 text-xs px-4 py-2 flex items-center justify-center gap-3 relative border-b border-rule dark:border-rule-dark transition-all duration-300"
>
  <span>
    You're viewing the new portfolio —
    <a
      href="/v1/"
      class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 underline underline-offset-2 transition-colors duration-200"
    >
      View classic site ↗
    </a>
  </span>
  <button
    id="version-banner-dismiss"
    aria-label="Dismiss banner"
    class="absolute right-4 top-1/2 -translate-y-1/2 text-ink-400 dark:text-ink-300 hover:text-ink-900 dark:hover:text-ink-100 transition-colors duration-200 leading-none"
  >
    ✕
  </button>
</div>}

<script is:inline>
  (function () {
    var banner = document.getElementById('version-banner');
    if (!banner) return;
    if (localStorage.getItem('version-banner-dismissed') === '1') {
      banner.style.display = 'none';
    }
    var btn = document.getElementById('version-banner-dismiss');
    if (btn) {
      btn.addEventListener('click', function () {
        banner.style.display = 'none';
        localStorage.setItem('version-banner-dismissed', '1');
      });
    }
  })();
</script>
