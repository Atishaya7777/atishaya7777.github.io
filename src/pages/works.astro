---
import Icon from '../components/Icon/Icon.astro';
import Layout from '../layouts/Layout.astro';
import routes from '../global/routes';
import { people, groups, refs, a, peopleHtml } from '../global/people';

const experience = [
	{
		dates: 'Mar 2024 – Present',
		role: 'Software Engineer',
		org: 'LG Electronics · Englewood Cliffs, USA (Remote)',
		points: [
			'Shipped Next.js, Redux, and TypeScript B2B platform features for 1,000+ vendors, contributing to a 25% user-engagement lift.',
			'Designed analytics and tagging frameworks adopted by 6+ product teams, enabling real-time measurement and data-driven feature prioritization.',
			'Built AI-powered global search with 35 ms lower latency and checkout workflows that drove a 15% conversion lift across promo-code and magic-link flows.',
		],
	},
	{
		dates: 'Present',
		role: 'Tech Lead',
		org: 'Vibecore · Remote',
		points: [
			'Lead a small engineering team building a GitHub-native software verification platform for founders who build with AI coding tools.',
			'Automated CI/CD deployments from GitHub Actions to AWS EC2, standardizing releases for EC2-hosted applications.',
			'Configured S3, DynamoDB, and IAM permissions for cloud-connected application workflows.',
			'Provisioned and maintained EBS/EFS storage for application data and deployment infrastructure.',
		],
	},
	{
		dates: 'Jun 2025 – Jan 2026',
		role: 'Software Engineer',
		org: 'Hoek Insights · Amsterdam, Netherlands (Remote)',
		points: [
			'Engineered a Python package for Three.js visualizations in Jupyter, reducing render time by 38% and bundle size by 25% through React renderer optimization.',
			'Shipped a FastAPI and PostgreSQL MVP with 18+ endpoints and 10 product workflows.',
			'Maintained below 200 ms median staging latency and 95% integration-test coverage through automated API testing.',
		],
	},
	{
		dates: 'Aug 2019 – Apr 2024',
		role: 'Software Engineer',
		org: 'Timeero · Phoenix, USA (Remote)',
		points: [
			'Led frontend development of a TypeScript, React, Vite, and Mapbox mileage-tracking application supporting 1,000+ active users.',
			'Shipped 15+ geospatial workflows for segment mapping, mileage capture, and field operations.',
			'Improved time-capture accuracy by 30% through Mapbox-based mapping and production workflow refinements.',
		],
	},
];

const research = [
	{
		dates: 'Mar 2024 – Present',
		role: 'Undergraduate Researcher — Algorithms & Computational Geometry',
		org: 'GADA Lab · University of Manitoba',
		orgUrl: groups.gada.url,
		supervisors: [people.durocher, people.naredla, people.zhu, people.miller],
		points: [
			`Fuel-efficient collaborative delivery: an O(n²) algorithm for the line-restricted setting (improving the previous O(n³) bound from ${a(refs.walcom2025.url, refs.walcom2025.label)}), an O(n³) algorithm for the L1 setting, and an NP-hardness proof for the Euclidean setting, where the L1 algorithm gives a √2-approximation.`,
			'Developed an approximation algorithm for Hamiltonian-path optimization in spatially embedded graphs with visualization and randomized testing across 100+ synthetic instances.',
			'Improved a noncrossing spanning-tree research library by 30% and strengthened its Python testing, documentation, and development practices.',
		],
	},
	{
		dates: 'Sep 2026 – Apr 2027',
		role: 'Honours Research Project — Calibrated Risk Prediction',
		org: 'Department of Computer Science · University of Manitoba',
		orgUrl: null,
		supervisors: [people.henry, people.sayari, people.salehkalaibar],
		points: [
			'Building calibrated models for potato pathogen-risk and yield-loss prediction, in collaboration with the Department of Plant Science.',
		],
	},
	{
		dates: 'May 2025 – Present',
		role: 'Machine Learning Researcher',
		org: 'Terrabyte ML Research Group',
		orgUrl: groups.terrabyte.url,
		supervisors: [],
		points: [
			'Extended diffusion-based learning to higher-order relational data by implementing 4 Hypergraph Neural Diffusion variants with PyTorch and PyTorch Geometric.',
			'Built an MLflow pipeline tracking configurations, metrics, and evaluations for 25+ experiments across 5+ datasets.',
		],
	},
	{
		dates: 'Jan 2024 – Jul 2025',
		role: 'Undergraduate Researcher — Combinatorics & Graph Theory',
		org: 'MXML · Department of Mathematics · University of Manitoba',
		orgUrl: groups.mxml.url,
		supervisors: [people.arman, people.shirazi],
		points: [
			'Established a coefficientwise inequality underlying the Hurlbert–Kamat property for perfect m-ary trees and derived a closed-form expression for their independence number.',
			'Used generating functions, polynomial recurrences, and induction, with SageMath validation across 1,000+ instances.',
		],
	},
];

const projects = [
	{
		title: 'PayTime — 1st Place, CSSA Design & Craft',
		year: '2026',
		stack: 'Next.js · TypeScript · FastAPI · Python · Supabase',
		description:
			'Won 1st place at the 2026 CSSA Design & Craft Case Competition by building an auditable payroll-ingestion platform in a 6.5-hour technical sprint. Implemented field mapping, validation, exception review, and source traceability for CSV, XLSX, PDF, image, and email-derived records.',
		link: { href: 'https://umanitobacssa.ca/events/case-competition-2026', label: 'Competition' },
		externalLink: { href: 'https://github.com/pieberrykinnie/paytime', label: 'GitHub' },
	},
	{
		title: 'HAPA — Winner, AccelR8 Prairie AI Hackathon',
		year: '2026',
		stack: 'Next.js · React · TypeScript · AI/LLM',
		description:
			'Won the 2026 AccelR8 Prairie AI Hackathon with a working personalized-shopping prototype built in 12 hours. Combined onboarding preferences, swipe feedback, and natural-language/voice pivots to adapt recommendations, with an extensible design for multimodal personalization and AI-assisted commerce.',
		link: { href: 'https://www.accelr8.ca/event-details/accelr8-prairie-ai-hackathon-2026', label: 'Hackathon' },
		externalLink: { href: 'https://github.com/pieberrykinnie/hapa', label: 'GitHub' },
	},
	{
		title: 'EkNepal',
		year: '2024',
		stack: 'Frontend · Professional Project · Alpinist Studios',
		description:
			'A news-aggregation platform bringing reporting from multiple Nepali publications into one interface. My first paid programming project — I contributed to the frontend while working through Alpinist Studios. The public product is proprietary; the source is not published.',
		link: { href: routes.eknepal, label: 'Project note' },
		externalLink: { href: 'https://eknepal.com/', label: 'eknepal.com' },
	},
	{
		title: 'Brainstorm',
		year: '2026',
		stack: 'Next.js · FastAPI · PostgreSQL · Pinecone · Redis · RAG',
		description:
			'AI-powered, role-specific knowledge management system (144 commits, 4 collaborators). Integrated Pinecone, Jira, Redis, and PostgreSQL with interactive charts. Implemented retrieval-augmented generation with role-based access controls across 4 integrated systems. Built a model-routing layer with dynamic model selection and fallback policies. Demoed to 7 users at Sprint to Innovate 2026; pitched for the CIPS Manitoba Challenge.',
	},
	{
		title: 'WinLocate',
		year: '2026',
		stack: 'React · Socrata API · Full-Stack · Civic Data',
		description:
			'Full-stack civic-data platform helping organizations compare Winnipeg locations using city data, zoning maps, budget estimates, and relocation-planning tools. Integrated City of Winnipeg open datasets via the Socrata API into interactive comparisons and maps. 1st place, 2026 Winnipeg Open Data Datathon.',
		link: { href: routes.winlocate, label: 'Project note' },
		externalLink: { href: 'https://www.linkedin.com/posts/edwinnipeg_winnipeg-opendata-datathon-activity-7436856469112901632-dLVI', label: 'Winner announcement' },
	},
	{
		title: 'Get Good Grades',
		year: '2026',
		stack: 'Electron · React · TypeScript · YAML',
		description:
			'Desktop flashcard application that reads user-controlled .yaml deck files directly from the local file system, separating flashcard content from the viewer so decks stay portable and shareable as plain text. Sole designer and developer. Winner, "Most Chaotic Evil Hack," .devHacks 2026.',
		link: { href: routes.getGoodGrades, label: 'Project note' },
	},
	{
		title: 'Spatially Embedded Graphs',
		year: '2024–Present',
		stack: 'Python · Algorithms · Visualisation',
		description:
			'Modelled Hamiltonian paths in ℝ² for approximation algorithms. Generated 100+ randomised instances, built visualisation pipelines, and validated algorithm behaviour across synthetic inputs.',
	},
	{
		title: 'Hurlbert–Kamat Property in Perfect m-ary Trees',
		year: '2024',
		stack: 'SageMath · Combinatorics',
		description:
			'Investigated the HK-property in perfect m-ary trees using SageMath and combinatorial analysis. Implemented computational checks across 1,000+ cases to support conjecture validation.',
	},
	{
		title: '.devHacks — "Most Chaotic Evil Hack"',
		year: '2025',
		stack: 'React.js · FastAPI · BERT · Supabase · TailwindCSS',
		description:
			"Winner of 'Most Chaotic Evil Hack' among 20+ teams. Built a chatroom using websockets with a BERT + PyTorch text classification model that categorises messages (e.g. 'brainrot', 'nerdy', 'dad joke') and rewards users with in-game currency. Built the FastAPI backend with Supabase for persistent storage and message reactions.",
	},
	{
		title: 'CSSA CTF — 1st & 2nd Place',
		year: '2025–2026',
		stack: 'C · Python · Cryptography · Ghidra',
		description:
			'1st place among 41 teams (2026) and 2nd place among 25+ teams (2025) at the annual CSSA Capture the Flag competition. Achieved 3rd place for Computational Sciences in the Summer Undergraduate Research Experience poster competition among 50+ student researchers.',
	},
];

const skills = [
	{ label: 'Languages', value: 'JavaScript, TypeScript, Python, Java, C, C++, R, SageMath, Bash, SQL' },
	{ label: 'Databases', value: 'PostgreSQL, MongoDB, DynamoDB, SQLite, MSSQL, Pinecone (Vector DB), Redis' },
	{ label: 'Web Frameworks', value: 'Next.js, React.js, FastAPI, Node.js, Astro' },
	{ label: 'ML / Data', value: 'PyTorch, PyTorch Geometric, NumPy, SciPy, Scikit-learn, MLFlow, Pandas' },
	{ label: 'Cloud & Infrastructure', value: 'AWS EC2, S3, DynamoDB, IAM, EBS/EFS, Docker, GitHub Actions, Linux' },
	{ label: 'Engineering Practices', value: 'CI/CD, API design, integration testing, automated testing, reproducible experimentation' },
	{ label: 'Specializations', value: 'Full-stack development, cloud infrastructure, ML systems, geospatial systems' },
	{ label: 'Developer Tools', value: 'Git, Tmux, Neovim, VS Code, IntelliJ, Figma, Jupyter' },
	{ label: 'Research Tools', value: 'Model Context Protocol, Three.js, LaTeX, Beamer, Jupyter' },
];
---

<Layout title="Works — Atishaya Maharjan" description="Software engineering and research work by Atishaya Maharjan — full-stack development in React, TypeScript, and Python, plus algorithms and graph-theory research at the University of Manitoba.">
	<div class="max-w-3xl mx-auto px-6">

		<!-- Page header -->
		<header class="pt-20 pb-12 text-center">
			<h1 class="font-display font-medium text-4xl sm:text-5xl text-ink-900 dark:text-ink-100 mb-4">Works</h1>
			<p class="text-base text-ink-500 dark:text-ink-300 max-w-xl mx-auto leading-relaxed">
				Professional experience, research contributions, personal projects, and technical skills.
			</p>
		</header>

		<hr class="border-t-4 border-double border-ink-900 dark:border-ink-100" />

		<!-- ── 1. Professional Experience ── -->
		<section class="py-12">
			<h2 class="font-display text-2xl text-ink-900 dark:text-ink-100 mb-8">
				<span class="text-ink-400 dark:text-ink-300 mr-2">1.</span>Professional Experience
			</h2>
			<div class="space-y-10">
				{experience.map((job) => (
					<div class="grid md:grid-cols-[150px_1fr] gap-x-8 gap-y-1">
						<p class="text-xs tracking-wide text-ink-400 dark:text-ink-300 pt-1.5">{job.dates}</p>
						<div>
							<h3 class="font-display text-xl text-ink-900 dark:text-ink-100 mb-0.5">{job.role}</h3>
							<p class="text-sm text-accent-600 dark:text-accent-300 mb-3">{job.org}</p>
							<ul class="space-y-1.5 text-sm text-ink-500 dark:text-ink-300 list-none">
								{job.points.map((point) => (
									<li class="flex gap-2"><span class="text-ink-400 dark:text-ink-300 shrink-0">–</span>{point}</li>
								))}
							</ul>
						</div>
					</div>
				))}
			</div>
		</section>

		<hr class="border-rule dark:border-rule-dark" />

		<!-- ── 2. Research ── -->
		<section class="py-12">
			<h2 class="font-display text-2xl text-ink-900 dark:text-ink-100 mb-8">
				<span class="text-ink-400 dark:text-ink-300 mr-2">2.</span>Research
			</h2>
			<div class="space-y-10">
				{research.map((position) => (
					<div class="grid md:grid-cols-[150px_1fr] gap-x-8 gap-y-1">
						<p class="text-xs tracking-wide text-ink-400 dark:text-ink-300 pt-1.5">{position.dates}</p>
						<div>
							<h3 class="font-display text-xl text-ink-900 dark:text-ink-100 mb-0.5">{position.role}</h3>
							<p class="text-sm mb-1">
								{position.orgUrl ? (
									<a href={position.orgUrl} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">{position.org}</a>
								) : (
									<span class="text-accent-600 dark:text-accent-300">{position.org}</span>
								)}
							</p>
							{position.supervisors.length > 0 && (
								<p class="text-sm text-ink-500 dark:text-ink-300">
									{position.supervisors.length > 1 ? 'Supervisors' : 'Supervisor'}: <Fragment set:html={peopleHtml(position.supervisors)} />
								</p>
							)}
							<ul class="mt-3 space-y-1.5 text-sm text-ink-500 dark:text-ink-300 list-none">
								{position.points.map((point) => (
									<li class="flex gap-2"><span class="text-ink-400 dark:text-ink-300 shrink-0">–</span><span set:html={point} /></li>
								))}
							</ul>
						</div>
					</div>
				))}
			</div>
		</section>

		<hr class="border-rule dark:border-rule-dark" />

		<!-- ── 3. Projects & Achievements ── -->
		<section class="py-12">
			<h2 class="font-display text-2xl text-ink-900 dark:text-ink-100 mb-8">
				<span class="text-ink-400 dark:text-ink-300 mr-2">3.</span>Projects &amp; Achievements
			</h2>
			<div class="space-y-8">
				{projects.map((project) => (
					<div>
						<div class="flex items-baseline justify-between gap-4 mb-1">
							<h3 class="font-display text-xl text-ink-900 dark:text-ink-100">{project.title}</h3>
							<span class="text-xs text-ink-400 dark:text-ink-300 whitespace-nowrap">{project.year}</span>
						</div>
						<p class="text-xs tracking-[0.12em] uppercase text-ink-400 dark:text-ink-300 mb-2">{project.stack}</p>
						<p class="text-sm text-ink-500 dark:text-ink-300 leading-relaxed">{project.description}</p>
						{(project.link || project.externalLink) && (
							<p class="mt-2 text-sm">
								{project.link && (
									<a href={project.link.href} {...(project.link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})} class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">{project.link.label}<Icon name={project.link.href.startsWith('http') ? 'arrow-up-right' : 'arrow-right'} class="ml-[0.2em]" /></a>
								)}
								{project.link && project.externalLink && <span class="text-ink-400 dark:text-ink-300 mx-2">·</span>}
								{project.externalLink && (
									<a href={project.externalLink.href} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">{project.externalLink.label}<Icon name="arrow-up-right" class="ml-[0.2em]" /></a>
								)}
							</p>
						)}
					</div>
				))}
			</div>
		</section>

		<hr class="border-rule dark:border-rule-dark" />

		<!-- ── 4. Technical Skills ── -->
		<section class="py-12">
			<h2 class="font-display text-2xl text-ink-900 dark:text-ink-100 mb-8">
				<span class="text-ink-400 dark:text-ink-300 mr-2">4.</span>Technical Skills
			</h2>
			<div class="space-y-4">
				{skills.map(({ label, value }) => (
					<div class="grid grid-cols-[130px_1fr] gap-4 items-baseline">
						<span class="text-xs tracking-[0.12em] uppercase text-ink-400 dark:text-ink-300">{label}</span>
						<span class="text-sm text-ink-700 dark:text-ink-200">{value}</span>
					</div>
				))}
			</div>
		</section>

	</div>
</Layout>
