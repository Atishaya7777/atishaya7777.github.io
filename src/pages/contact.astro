---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — Atishaya Maharjan" description="Get in touch with Atishaya Maharjan.">
	<div class="max-w-5xl mx-auto px-6 py-16">

		<!-- Page header -->
		<div class="mb-16">
			<h1 class="font-cormorant text-5xl text-primary-900 dark:text-background-100 mb-4">Contact</h1>
			<p class="text-base text-primary-600 dark:text-background-400 font-body max-w-xl leading-relaxed">
				For research collaborations, academic enquiries, or to say hello — email is the best way to reach me.
			</p>
		</div>

		<hr class="border-primary-100 dark:border-primary-300 mb-16" />

		<!-- Email -->
		<section class="mb-16">
			<h2 class="font-cormorant text-3xl text-primary-800 dark:text-background-200 mb-6">Email</h2>
			<a
				href="mailto:atishaya7777@gmail.com"
				class="text-xl font-cormorant text-tertiary-600 dark:text-tertiary-400 hover:text-tertiary-800 dark:hover:text-tertiary-300 transition-colors"
			>
				atishaya7777@gmail.com
			</a>
			<p class="text-sm text-primary-500 dark:text-background-500 font-body mt-3 leading-relaxed max-w-lg">
				I try to reply within a few days. If you're reaching out about research or a collaboration, please include a brief description of what you have in mind.
			</p>
		</section>

		<hr class="border-primary-100 dark:border-primary-300 mb-16" />

		<!-- Links -->
		<section class="mb-16">
			<h2 class="font-cormorant text-3xl text-primary-800 dark:text-background-200 mb-8">Elsewhere</h2>
			<div class="space-y-6">
				<div class="flex items-baseline gap-8">
					<span class="text-xs uppercase tracking-widest text-primary-400 dark:text-background-600 font-body w-20 shrink-0">GitHub</span>
					<a href="https://github.com/Atishaya7777" target="_blank" rel="noopener noreferrer" class="text-base text-primary-700 dark:text-background-300 hover:text-tertiary-600 dark:hover:text-tertiary-400 transition-colors font-body">
						github.com/Atishaya7777 ↗
					</a>
				</div>
				<div class="flex items-baseline gap-8">
					<span class="text-xs uppercase tracking-widest text-primary-400 dark:text-background-600 font-body w-20 shrink-0">LinkedIn</span>
					<a href="https://www.linkedin.com/in/atishaya-maharjan07" target="_blank" rel="noopener noreferrer" class="text-base text-primary-700 dark:text-background-300 hover:text-tertiary-600 dark:hover:text-tertiary-400 transition-colors font-body">
						linkedin.com/in/atishaya-maharjan07 ↗
					</a>
				</div>
			</div>
		</section>

		<hr class="border-primary-100 dark:border-primary-300 mb-16" />

		<!-- Topics -->
		<section class="mb-8">
			<h2 class="font-cormorant text-3xl text-primary-800 dark:text-background-200 mb-8">I enjoy talking about</h2>
			<div class="grid sm:grid-cols-2 gap-x-12 gap-y-4">
				<div>
					<h3 class="font-cormorant text-lg text-primary-900 dark:text-background-100 mb-1">Research mathematics</h3>
					<p class="text-sm text-primary-600 dark:text-background-500 font-body leading-relaxed">Combinatorics, graph theory, algorithms — always happy to geek out about a new problem or proof idea.</p>
				</div>
				<div>
					<h3 class="font-cormorant text-lg text-primary-900 dark:text-background-100 mb-1">Graduate school & academia</h3>
					<p class="text-sm text-primary-600 dark:text-background-500 font-body leading-relaxed">Thinking about grad programs, research positions, or navigating academic life? I'm happy to share what I know.</p>
				</div>
				<div>
					<h3 class="font-cormorant text-lg text-primary-900 dark:text-background-100 mb-1">Software & web development</h3>
					<p class="text-sm text-primary-600 dark:text-background-500 font-body leading-relaxed">Frontend projects, interesting libraries, architectural decisions — always up for a technical discussion.</p>
				</div>
				<div>
					<h3 class="font-cormorant text-lg text-primary-900 dark:text-background-100 mb-1">Teaching & learning</h3>
					<p class="text-sm text-primary-600 dark:text-background-500 font-body leading-relaxed">Have a concept you're stuck on? Want to share a pedagogy insight? I'm always happy to help or learn something new.</p>
				</div>
			</div>
		</section>

	</div>
</Layout>
