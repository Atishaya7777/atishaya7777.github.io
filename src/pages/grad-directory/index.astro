---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon/Icon.astro';
import DirectorySearch from '../../components/Directory/DirectorySearch';
import '../../components/Directory/directory.css';
import { professors, universities, universityNames } from '../../lib/directory/data';
const today = new Date().toISOString();
const covered = universities.filter(u => u.professors.length).length;
---
<Layout title="Canadian Graduate Supervisor Directory — CS & Mathematics" description="Explore Canadian computer science and mathematics professors, advertised graduate openings, funding statements, and original sources. Partial coverage, with evidence for every claim.">
  <div class="max-w-4xl mx-auto px-6 pt-8 pb-16">
    <header>
      <h1 class="font-display text-4xl sm:text-5xl font-medium leading-tight text-ink-900 dark:text-ink-100">Canadian Graduate Supervisor Directory <button id="directory-info-btn" type="button" class="directory-info-btn ml-1" popovertarget="directory-notes" aria-label="About these records"><Icon name="info" /></button></h1>
      <p class="mt-3 max-w-2xl leading-relaxed">Public computer science and mathematics supervisors, with the sources behind each record.</p>
      <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm text-ink-500 dark:text-ink-300">
        <li>{professors.length} professors</li>
        <li>{covered} universities</li>
        <li>CS and mathematics</li>
      </ul>
    </header>
    <div id="directory-notes" popover anchor="directory-info-btn" class="directory-popover">
      <p>Openings come from public pages. They are not a guaranteed place. Unknown means no recruitment statement was found. This is a partial list of faculty at six universities.</p>
      <a href="/grad-directory/about" class="directory-link mt-3 inline-flex items-center gap-1.5">How to read this directory <Icon name="arrow-right" /></a>
    </div>
    <DirectorySearch professors={professors} universities={universityNames} today={today} client:load />
  </div>
</Layout>
