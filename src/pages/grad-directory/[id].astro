---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon/Icon.astro';
import Portrait from '../../components/Directory/Portrait';
import '../../components/Directory/directory.css';
import { professors, universityNames } from '../../lib/directory/data';
import { dateLabel, degreeLabels, disciplineLabels, expired, fundingLabels, overdue, recruitmentLabels } from '../../lib/directory/model';
import type { Professor } from '../../lib/directory/types';
export function getStaticPaths() { return professors.map(professor => ({ params: { id: professor.id }, props: { professor } })); }
const { professor: p } = Astro.props as { professor: Professor };
const university = universityNames[p.universityId];
const now = new Date();
const page = new URL(Astro.url.pathname, Astro.site).href;
const correction = `mailto:atishaya7777@gmail.com?subject=${encodeURIComponent(`Directory correction: ${p.name} (${p.id})`)}&body=${encodeURIComponent(`Professor: ${p.name}\nUniversity: ${university}\nPage: ${page}\n\nCorrection and supporting source:\n`)}`;
---
<Layout title={`${p.name} — ${university} | Grad Directory`} description={`Research interests, public graduate recruitment and funding statements for ${p.name} at ${university}, with original sources.`}>
  <article class="max-w-4xl mx-auto px-6 pt-8 pb-16">
    <nav class="text-sm" aria-label="Breadcrumb">
      <a class="directory-link inline-flex items-center gap-1.5" href="/grad-directory"><Icon name="arrow-left" /> Graduate supervisor directory</a>
    </nav>
    <header class="mt-6 flex items-start gap-4 sm:gap-6">
      <Portrait professor={p} large />
      <div class="min-w-0">
        <p class="text-sm text-ink-500 dark:text-ink-300">{p.disciplines.map(d => disciplineLabels[d]).join(', ')}</p>
        <h1 class="font-display text-4xl sm:text-5xl font-medium text-ink-900 dark:text-ink-100 leading-tight mt-1">{p.name}</h1>
        <p class="mt-2 text-sm text-ink-500 dark:text-ink-300">{university}{p.department ? `, ${p.department}` : ''}</p>
      </div>
    </header>

    <section class="mt-6 py-6 border-t border-b border-rule dark:border-rule-dark">
      <h2 class="font-display text-2xl text-ink-900 dark:text-ink-100">Research &amp; original profiles</h2>
      <p class="mt-3 leading-relaxed">{p.interests.length ? p.interests.join(', ') : 'Research interests have not yet been catalogued. Please consult the original profile.'}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2 mt-3 text-sm">
        {p.links.map(link => <li><a class="directory-link inline-flex items-center gap-1" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} <Icon name="arrow-up-right" /></a></li>)}
      </ul>
    </section>

    {p.conflicts.length > 0 && (
      <aside class="mt-6 border border-rule-strong dark:border-rule-dark-strong p-4">
        <h2 class="font-bold">Conflicting statements need clarification</h2>
        <ul class="mt-2 space-y-2 text-sm">{p.conflicts.map(conflict => <li>{conflict}</li>)}</ul>
      </aside>
    )}

    <section class="py-6 border-b border-rule dark:border-rule-dark">
      <div id="recruitment-anchor" class="flex items-center gap-1.5">
        <h2 class="font-display text-2xl text-ink-900 dark:text-ink-100">Graduate recruitment</h2>
        <button id="recruitment-info" type="button" class="directory-info-btn" popovertarget="recruitment-notes" aria-label="About recruitment statements">
          <Icon name="info" />
        </button>
      </div>
      <div id="recruitment-notes" popover anchor="recruitment-anchor" class="directory-popover">
        <p>A public opening is an invitation to apply, not an admission or funding guarantee. Unknown means no recruitment statement was found.</p>
      </div>
      {p.recruitment.length ? p.recruitment.map(claim => (
        <article class="mt-4">
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="directory-label">{recruitmentLabels[claim.status]}</span>
            <span class="directory-label">{degreeLabels[claim.degree]}</span>
            {claim.intake && <span class="directory-label">{claim.intake}</span>}
            {expired(claim, now) && <span class="directory-label">Past advertised intake or deadline</span>}
            {overdue(claim.evidence.checkedAt, now) && <span class="directory-label">Source check overdue</span>}
          </div>
          <p class="mt-3 leading-relaxed">{claim.summary}</p>
          {claim.validUntil && <p class="mt-2 text-sm">Advertised until {claim.validUntil}</p>}
          <blockquote class="directory-evidence mt-3 text-sm leading-relaxed">
            <p>“{claim.evidence.quote}”</p>
            <footer class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-ink-500 dark:text-ink-300">
              <a class="directory-link inline-flex items-center gap-1" href={claim.evidence.url}>Original source <Icon name="arrow-up-right" /></a>
              <span>Checked {dateLabel(claim.evidence.checkedAt)}</span>
              {claim.evidence.sourceDate && <span>Source date {claim.evidence.sourceDate}</span>}
            </footer>
          </blockquote>
        </article>
      )) : <p class="mt-3 leading-relaxed">Availability unknown. No recruitment statement has been catalogued.</p>}
    </section>

    <section class="py-6 border-b border-rule dark:border-rule-dark">
      <div id="funding-anchor" class="flex items-center gap-1.5">
        <h2 class="font-display text-2xl text-ink-900 dark:text-ink-100">Funding statements</h2>
        <button id="funding-info" type="button" class="directory-info-btn" popovertarget="funding-notes" aria-label="About funding statements">
          <Icon name="info" />
        </button>
      </div>
      <div id="funding-notes" popover anchor="funding-anchor" class="directory-popover">
        <p>A grant is not an available funded place. Check the original source for amounts, duration, and conditions.</p>
      </div>
      {p.funding.length ? p.funding.map(claim => (
        <article class="mt-4">
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="directory-label">{fundingLabels[claim.status]}</span>
            <span class="directory-label">{degreeLabels[claim.degree]}</span>
            {claim.intake && <span class="directory-label">{claim.intake}</span>}
            {overdue(claim.evidence.checkedAt, now) && <span class="directory-label">Source check overdue</span>}
          </div>
          <p class="mt-3 leading-relaxed">{claim.summary}</p>
          <blockquote class="directory-evidence mt-3 text-sm leading-relaxed">
            <p>“{claim.evidence.quote}”</p>
            <footer class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-ink-500 dark:text-ink-300">
              <a class="directory-link inline-flex items-center gap-1" href={claim.evidence.url}>Original source <Icon name="arrow-up-right" /></a>
              <span>Checked {dateLabel(claim.evidence.checkedAt)}</span>
              {claim.evidence.sourceDate && <span>Source date {claim.evidence.sourceDate}</span>}
            </footer>
          </blockquote>
        </article>
      )) : <p class="mt-3">Funding not stated in the records catalogued so far.</p>}
    </section>

    {p.applicationInstructions && (
      <section class="py-6 border-b border-rule dark:border-rule-dark">
        <h2 class="font-display text-2xl text-ink-900 dark:text-ink-100">Application instructions</h2>
        <p class="mt-3 whitespace-pre-line leading-relaxed">{p.applicationInstructions}</p>
        <p class="mt-3 text-sm text-ink-500 dark:text-ink-300">Check the original recruitment sources for the full procedure and current deadlines.</p>
      </section>
    )}

    <section class="pt-6 text-sm leading-relaxed">
      <h2 class="font-display text-2xl text-ink-900 dark:text-ink-100">Record provenance</h2>
      <blockquote class="directory-evidence mt-4">
        <p>“{p.identityEvidence.quote}”</p>
        <footer class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-ink-500 dark:text-ink-300">
          <a class="directory-link inline-flex items-center gap-1" href={p.identityEvidence.url}>Identity and affiliation source <Icon name="arrow-up-right" /></a>
          <span>Checked {dateLabel(p.identityEvidence.checkedAt)}</span>
        </footer>
      </blockquote>
      <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
        <a class="directory-link inline-flex items-center gap-1" href={correction}>Report a correction <Icon name="arrow-up-right" /></a>
        <a class="directory-link inline-flex items-center gap-1" href="/grad-directory/about">About the directory <Icon name="arrow-right" /></a>
      </div>
    </section>
  </article>
</Layout>
