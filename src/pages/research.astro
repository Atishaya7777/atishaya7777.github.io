---
import Layout from '../layouts/Layout.astro';

const positions = [
	{
		dates: 'Mar 2024 – Present',
		role: 'Researcher — Algorithms & Graph Theory',
		org: 'GADA Lab (Geometric, Approximation & Distributed Algorithms)',
		orgUrl: 'https://home.cs.umanitoba.ca/~gada/',
		detail: 'University of Manitoba · Supervisor: Dr. Stephane Durocher',
		points: [
			'Developed a fast approximation algorithm for Hamiltonian path optimisation in spatially embedded graphs; built visualisation and randomised test-generation tooling across 100+ synthetic instances.',
			'Delivered talks at weekly GADA lab meetings on wiggly permutations and space-efficient Eulerian circuits (works by other authors).',
			'Contributed to noncrossing spanning trees library, improving performance by 30% and establishing Python best practices.',
			'Engineered hypergraph visualisation tool for ML research.',
		],
	},
	{
		dates: 'May 2025 – Present',
		role: 'Machine Learning Researcher',
		org: 'Terrabyte Machine Learning Research Group',
		orgUrl: 'https://terrabyte.acs.uwinnipeg.ca/',
		detail: 'University of Manitoba',
		points: [
			'Extended Graph Neural Diffusion architecture to Hypergraph Neural Diffusion networks using PyTorch and PyTorch Geometric, prototyping 4 model variants.',
			'Tracked 25+ experiments across 5+ datasets for reproducibility using MLFlow.',
		],
	},
	{
		dates: 'Jan 2024 – Jul 2025',
		role: 'Researcher — Combinatorics & Graph Theory',
		org: 'Department of Mathematics',
		orgUrl: null,
		detail: 'University of Manitoba · Supervisors: Dr. Mahsa Nasrollahi-Shirazi & Dr. Andrii Arman',
		points: [
			"Proved a closed-form solution for the independence number of perfect binary trees and verified Hurlbert–Kamat's Conjecture using generating functions and computational analysis across 1,000+ cases.",
		],
	},
];

const preprints = [
	{
		title: 'HK Property in Perfect Binary Trees',
		area: 'Combinatorics · Graph Theory',
		description:
			"Proved a closed-form solution for the independence number of perfect binary trees and verified Hurlbert–Kamat's Conjecture using generating functions and computational analysis across 1,000+ cases.",
		pdf: '/assets/hk_perfect_binary_trees.pdf',
	},
	{
		title: 'Wiener Index',
		area: 'Graph Theory',
		description:
			'Original research on the Wiener index — a topological graph invariant defined as the sum of pairwise distances between vertices — with novel combinatorial analysis and results.',
		pdf: '/assets/wiener-index.pdf',
	},
];

const talks = [
	{
		title: 'Spectral Graph Theory for Maze Solving',
		readingGroup: true,
		venue: 'GADA Lab Research Meetings · EITC E2, University of Manitoba',
		date: 'Jul 28, 2025',
		note: null,
		pdf: '/assets/spectral_graph_theory_for_maze_solving.pdf',
	},
	{
		title: 'Wiggly Permutations',
		readingGroup: true,
		venue: 'GADA Lab Research Meetings · University of Manitoba',
		date: 'Oct 3, 2025',
		note: 'Talk presenting the CCCG 2025 paper by its authors; presented as a reading-group talk.',
		pdf: '/assets/presentation-wiggly-prem.pdf',
	},
	{
		title: 'Space-Efficient Eulerian Circuits',
		readingGroup: true,
		venue: 'GADA Lab Research Meetings · University of Manitoba',
		date: 'Feb 4, 2026',
		note: 'Talk presenting the SOSA 2026 paper by its authors; presented as a reading-group talk.',
		pdf: '/assets/A%20Walkthrough%20of%20Eulerian%20Circuit%20Algorithms.pdf',
	},
	{
		title: 'Exploring Perfect Binary Trees with Relation to the HK-Property',
		readingGroup: false,
		venue: 'UM Combinatorics Seminar · Machray Hall, University of Manitoba',
		date: 'Mar 28, 2024',
		note: null,
		pdf: '/assets/perfect_binary_trees_hk_property.pdf',
	},
	{
		title: 'Git Fundamentals',
		readingGroup: false,
		venue: 'Coding Kickoff · EITC E2, University of Manitoba',
		date: 'Sep 18, 2024',
		note: null,
		pdf: '/assets/git_fundamentals.pdf',
	},
];

const ongoing = [
	{
		title: 'Algorithmic Game Theory with Memory Pooling',
		description: 'Investigating game-theoretic models and their interaction with memory-pooling techniques in algorithm design.',
	},
	{
		title: 'Hypergraph Neural Networks',
		description: 'Extending diffusion-based GNN architectures to hypergraph settings via PyTorch Geometric; prototyping novel message-passing schemes.',
	},
	{
		title: 'HK-Property for Binary Trees',
		description: 'Continuing investigation into the Hurlbert–Kamat property for more general tree families beyond the perfect binary case.',
	},
];
---

<Layout title="Research — Atishaya Maharjan" description="Research positions, preprints, working papers, talks, and presentations by Atishaya Maharjan.">
	<div class="max-w-3xl mx-auto px-6">

		<!-- Page header -->
		<header class="pt-20 pb-12 text-center">
			<h1 class="font-display font-medium text-4xl sm:text-5xl text-ink-900 dark:text-ink-100 mb-4">Research</h1>
			<p class="text-base text-ink-500 dark:text-ink-300 max-w-xl mx-auto leading-relaxed">
				Research positions, original preprints and working papers, talks, and ongoing investigations.
			</p>
		</header>

		<hr class="border-t-4 border-double border-ink-900 dark:border-ink-100" />

		<!-- ── 1. Positions ── -->
		<section class="py-12">
			<h2 class="font-display text-2xl text-ink-900 dark:text-ink-100 mb-8">
				<span class="text-ink-400 dark:text-ink-300 mr-2">1.</span>Positions
			</h2>
			<div class="space-y-10">
				{positions.map((position) => (
					<div class="grid md:grid-cols-[150px_1fr] gap-x-8 gap-y-1">
						<p class="text-xs tracking-wide text-ink-400 dark:text-ink-300 pt-1.5">{position.dates}</p>
						<div>
							<h3 class="font-display text-xl text-ink-900 dark:text-ink-100 mb-0.5">{position.role}</h3>
							<p class="text-sm mb-3">
								{position.orgUrl ? (
									<a href={position.orgUrl} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">
										{position.org}
									</a>
								) : (
									<span class="text-accent-600 dark:text-accent-300">{position.org}</span>
								)}
								<span class="text-ink-500 dark:text-ink-300"> · {position.detail}</span>
							</p>
							<ul class="space-y-1.5 text-sm text-ink-500 dark:text-ink-300 list-none">
								{position.points.map((point) => (
									<li class="flex gap-2"><span class="text-ink-400 dark:text-ink-300 shrink-0">–</span>{point}</li>
								))}
							</ul>
						</div>
					</div>
				))}
			</div>
		</section>

		<hr class="border-rule dark:border-rule-dark" />

		<!-- ── 2. Preprints & Working Papers ── -->
		<section class="py-12">
			<h2 class="font-display text-2xl text-ink-900 dark:text-ink-100 mb-3">
				<span class="text-ink-400 dark:text-ink-300 mr-2">2.</span>Preprints &amp; Working Papers
			</h2>
			<p class="text-sm text-ink-400 dark:text-ink-300 italic mb-8">
				Original novel work. Unpublished and not yet peer-reviewed.
			</p>
			<ol class="space-y-6 text-[15px] leading-[1.8] list-none">
				{preprints.map((paper, i) => (
					<li class="pl-8 relative">
						<span class="absolute left-0 text-ink-400 dark:text-ink-300">[{i + 1}]</span>
						Maharjan, A. <em class="font-display">{paper.title}.</em>
						<span class="text-ink-500 dark:text-ink-300"> {paper.area}. {paper.description} </span>
						<a href={paper.pdf} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors whitespace-nowrap">[PDF]</a>
					</li>
				))}
			</ol>
		</section>

		<hr class="border-rule dark:border-rule-dark" />

		<!-- ── 3. Talks & Presentations ── -->
		<section class="py-12">
			<h2 class="font-display text-2xl text-ink-900 dark:text-ink-100 mb-3">
				<span class="text-ink-400 dark:text-ink-300 mr-2">3.</span>Talks &amp; Presentations
			</h2>
			<p class="text-sm text-ink-400 dark:text-ink-300 italic mb-8">
				Talks marked with an asterisk (*) present papers authored by others, given as reading-group talks.
			</p>
			<div class="space-y-6">
				{talks.map((talk) => (
					<div class="grid md:grid-cols-[150px_1fr] gap-x-8 gap-y-1">
						<p class="text-xs tracking-wide text-ink-400 dark:text-ink-300 pt-1.5">{talk.date}</p>
						<div>
							<h3 class="font-display text-lg text-ink-900 dark:text-ink-100">
								{talk.title}{talk.readingGroup && <span class="text-ink-400 dark:text-ink-300"> *</span>}
							</h3>
							<p class="text-xs tracking-[0.08em] uppercase text-ink-400 dark:text-ink-300 mt-0.5">{talk.venue}</p>
							{talk.note && <p class="text-xs text-ink-400 dark:text-ink-300 italic mt-1">{talk.note}</p>}
							<p class="text-sm mt-1.5">
								<a href={talk.pdf} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">[Slides]</a>
							</p>
						</div>
					</div>
				))}
			</div>
		</section>

		<hr class="border-rule dark:border-rule-dark" />

		<!-- ── 4. Ongoing Work ── -->
		<section class="py-12">
			<h2 class="font-display text-2xl text-ink-900 dark:text-ink-100 mb-8">
				<span class="text-ink-400 dark:text-ink-300 mr-2">4.</span>Ongoing Work
			</h2>
			<div class="space-y-5 text-[15px] leading-[1.8]">
				{ongoing.map((item) => (
					<p>
						<strong class="font-semibold text-ink-900 dark:text-ink-100">{item.title}.</strong>
						{' '}{item.description}
					</p>
				))}
			</div>
		</section>

	</div>
</Layout>
