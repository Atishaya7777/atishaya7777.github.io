---
import Layout from '../layouts/Layout.astro';

import { people, groups, refs, a, peopleHtml, linkClass } from '../global/people';

const positions = [
	{
		dates: 'Mar 2024 – Present',
		role: 'Undergraduate Researcher — Algorithms & Computational Geometry',
		org: groups.gada.name,
		orgUrl: groups.gada.url,
		detail: 'University of Manitoba',
		supervisors: [people.durocher, people.naredla, people.zhu, people.miller],
		points: [
			`Co-authoring <em>Geometric Algorithms and Hardness for Fuel-Efficient Collaborative Delivery</em>, which studies how cooperating delivery agents (e.g. drones) can move a package while minimizing total fuel use.`,
			`Results include an O(n²) algorithm for the line-restricted setting, improving the previous O(n³) bound from ${a(refs.walcom2025.url, refs.walcom2025.label)}, and an O(n³) algorithm for the unrestricted L1 setting.`,
			'We prove the Euclidean (L2) setting is NP-hard, and show that the L1 algorithm gives a √2-approximation for it.',
			'Developed an approximation algorithm for Hamiltonian-path optimization in spatially embedded graphs, with visualization and randomized testing across 100+ synthetic instances.',
			'Improved the performance of a noncrossing spanning-tree research library by 30% and introduced stronger Python testing, documentation, and development practices.',
			`Gave reading-group talks at weekly GADA lab meetings (see ${'<a href="#talks" class="' + linkClass + '">Talks</a>'}).`,
		],
	},
	{
		dates: 'Sep 2026 – Apr 2027',
		role: 'Honours Research Project — Calibrated Risk Prediction',
		org: 'Department of Computer Science',
		orgUrl: null,
		detail: 'University of Manitoba',
		supervisors: [people.henry, people.sayari, people.salehkalaibar],
		points: [
			'Building calibrated models that predict potato pathogen risk and yield loss, so that predicted probabilities can be trusted when making decisions under uncertainty.',
			'Interdisciplinary project in collaboration with the Department of Plant Science.',
		],
	},
	{
		dates: 'May 2025 – Present',
		role: 'Machine Learning Researcher',
		org: groups.terrabyte.name,
		orgUrl: groups.terrabyte.url,
		detail: 'Winnipeg',
		supervisors: [],
		points: [
			'Extended diffusion-based learning to higher-order relational data by implementing 4 Hypergraph Neural Diffusion variants in PyTorch and PyTorch Geometric.',
			'Built a reproducible MLflow pipeline tracking configurations, metrics, and evaluations for 25+ experiments across 5+ datasets.',
		],
	},
	{
		dates: 'Jan 2024 – Jul 2025',
		role: 'Undergraduate Researcher — Combinatorics & Graph Theory',
		org: groups.mxml.name,
		orgUrl: groups.mxml.url,
		detail: 'Department of Mathematics, University of Manitoba',
		supervisors: [people.arman, people.shirazi],
		points: [
			'Established a coefficientwise inequality underlying the Hurlbert–Kamat property for perfect m-ary trees, and derived a closed-form expression for their independence number.',
			'Used generating functions, polynomial recurrences, induction, and coefficientwise analysis to build the argument.',
			'Ran SageMath and Python experiments across 1,000+ instances to test conjectures, verify symbolic identities, and validate intermediate results.',
		],
	},
];

const preprints = [
	{
		authors: `${a(people.durocher.url, 'S. Durocher')}, <strong class="font-semibold text-ink-900 dark:text-ink-100">A. Maharjan</strong>, ${a(people.miller.url, 'A. Miller')}, ${a(people.naredla.url, 'A. M. Naredla')}`,
		title: 'Geometric Algorithms and Hardness for Fuel-Efficient Collaborative Delivery',
		status: 'Manuscript in preparation',
		area: 'Computational Geometry · Algorithms',
		description: `An O(n²) algorithm for the line-restricted setting (improving the O(n³) bound of ${a(refs.walcom2025.url, refs.walcom2025.label)}), an O(n³) algorithm for the L1 setting, NP-hardness for the Euclidean (L2) setting, and a √2-approximation for L2.`,
		pdf: null,
	},
	{
		authors: `${a(people.arman.url, 'A. Arman')}, <strong class="font-semibold text-ink-900 dark:text-ink-100">A. Maharjan</strong>, ${a(people.shirazi.url, 'M. N. Shirazi')}`,
		title: 'HK Property in Perfect Binary Trees',
		status: 'Preprint',
		area: 'Combinatorics · Graph Theory',
		description:
			"A generating-function framework for counting the sizes of stars (independent sets containing a fixed vertex) in perfect m-ary trees. It gives an alternate, coefficientwise proof of the HK-property for perfect m-ary trees, first proved by Iľkovič and Yan with a combinatorial injection. It also measures the gap between the leaf star and the root star through a structured recurrence, and recovers EKR consequences such as formulas for the independence number and the minimum size of a maximal independent set.",
		pdf: '/assets/hk_perfect_binary_trees.pdf',
	},
	{
		authors: '<strong class="font-semibold text-ink-900 dark:text-ink-100">A. Maharjan</strong>',
		title: 'Wiener Index',
		status: 'Report',
		area: 'Graph Theory · Heuristics',
		description:
			'Implementation of a heuristic algorithm for an open problem on the Wiener index (the sum of all pairwise distances between vertices of a graph), with an analysis of the problem. Exploratory; it does not resolve the problem.',
		pdf: '/assets/wiener-index.pdf',
	},
];

const talks = [
	{
		title: 'Spectral Graph Theory for Maze Solving',
		readingGroup: true,
		venue: 'GADA Lab Research Meetings · EITC E2, University of Manitoba',
		date: 'Jul 28, 2025',
		note: null,
		pdf: '/assets/spectral_graph_theory_for_maze_solving.pdf',
	},
	{
		title: 'Wiggly Permutations',
		readingGroup: true,
		venue: 'GADA Lab Research Meetings · University of Manitoba',
		date: 'Oct 3, 2025',
		note: 'Talk presenting the CCCG 2025 paper by its authors; presented as a reading-group talk.',
		pdf: '/assets/presentation-wiggly-prem.pdf',
	},
	{
		title: 'Space-Efficient Eulerian Circuits',
		readingGroup: true,
		venue: 'GADA Lab Research Meetings · University of Manitoba',
		date: 'Feb 4, 2026',
		note: 'Talk presenting the SOSA 2026 paper by its authors; presented as a reading-group talk.',
		pdf: '/assets/A%20Walkthrough%20of%20Eulerian%20Circuit%20Algorithms.pdf',
	},
	{
		title: 'Exploring Perfect Binary Trees with Relation to the HK-Property',
		readingGroup: false,
		venue: 'UM Combinatorics Seminar · Machray Hall, University of Manitoba',
		date: 'Mar 28, 2024',
		note: null,
		pdf: '/assets/perfect_binary_trees_hk_property.pdf',
	},
	{
		title: 'Git Fundamentals',
		readingGroup: false,
		venue: 'Coding Kickoff · EITC E2, University of Manitoba',
		date: 'Sep 18, 2024',
		note: null,
		pdf: '/assets/git_fundamentals.pdf',
	},
];

const ongoing = [
	{
		title: 'Fuel-Efficient Collaborative Delivery',
		description: `Writing up the manuscript with ${peopleHtml([people.durocher, people.naredla, people.miller])}, and exploring an implementation and benchmark of the line-restricted algorithm.`,
	},
	{
		title: 'Calibrated Pathogen-Risk Prediction',
		description: `Honours project with ${peopleHtml([people.henry])} on calibrated prediction of potato pathogen risk and yield loss — learning and decision-making under uncertainty.`,
	},
	{
		title: 'Hurlbert–Kamat Property for Trees',
		description: 'Continuing the investigation of the Hurlbert–Kamat property for tree families beyond the perfect binary case.',
	},
	{
		title: 'Hypergraph Neural Networks',
		description: 'Extending diffusion-based GNN architectures to hypergraphs with PyTorch Geometric.',
	},
];
---

<Layout title="Research — Atishaya Maharjan" description="Research positions, working papers, and talks in algorithms, computational geometry, combinatorial optimization, combinatorics, and learning under uncertainty, by Atishaya Maharjan at the University of Manitoba.">
	<div class="max-w-3xl mx-auto px-6">

		<!-- Page header -->
		<header class="pt-20 pb-12 text-center">
			<h1 class="font-display font-medium text-4xl sm:text-5xl text-ink-900 dark:text-ink-100 mb-4">Research</h1>
			<p class="text-base text-ink-500 dark:text-ink-300 max-w-xl mx-auto leading-relaxed">
				Research positions, original preprints and working papers, talks, and ongoing investigations.
			</p>
		</header>

		<hr class="border-t-4 border-double border-ink-900 dark:border-ink-100" />

		<!-- ── 1. Positions ── -->
		<section class="py-12">
			<h2 class="font-display text-2xl text-ink-900 dark:text-ink-100 mb-8">
				<span class="text-ink-400 dark:text-ink-300 mr-2">1.</span>Positions
			</h2>
			<div class="space-y-10">
				{positions.map((position) => (
					<div class="grid md:grid-cols-[150px_1fr] gap-x-8 gap-y-1">
						<p class="text-xs tracking-wide text-ink-400 dark:text-ink-300 pt-1.5">{position.dates}</p>
						<div>
							<h3 class="font-display text-xl text-ink-900 dark:text-ink-100 mb-0.5">{position.role}</h3>
							<p class="text-sm mb-3">
								{position.orgUrl ? (
									<a href={position.orgUrl} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">
										{position.org}
									</a>
								) : (
									<span class="text-accent-600 dark:text-accent-300">{position.org}</span>
								)}
								<span class="text-ink-500 dark:text-ink-300"> · {position.detail}</span>
							</p>
							{position.supervisors.length > 0 && (
								<p class="text-sm text-ink-500 dark:text-ink-300 mb-1">
									{position.supervisors.length > 1 ? 'Supervisors' : 'Supervisor'}: <Fragment set:html={peopleHtml(position.supervisors)} />
								</p>
							)}
							<div class="mb-3"></div>
							<ul class="space-y-1.5 text-sm text-ink-500 dark:text-ink-300 list-none">
								{position.points.map((point) => (
									<li class="flex gap-2"><span class="text-ink-400 dark:text-ink-300 shrink-0">–</span><span set:html={point} /></li>
								))}
							</ul>
						</div>
					</div>
				))}
			</div>
		</section>

		<hr class="border-rule dark:border-rule-dark" />

		<!-- ── 2. Preprints & Working Papers ── -->
		<section class="py-12">
			<h2 class="font-display text-2xl text-ink-900 dark:text-ink-100 mb-3">
				<span class="text-ink-400 dark:text-ink-300 mr-2">2.</span>Preprints &amp; Working Papers
			</h2>
			<p class="text-sm text-ink-400 dark:text-ink-300 italic mb-8">
				Not yet peer-reviewed. Author order is alphabetical, as is standard in theoretical computer science.
			</p>
			<ol class="space-y-6 text-[15px] leading-[1.8] list-none">
				{preprints.map((paper, i) => (
					<li class="pl-8 relative">
						<span class="absolute left-0 text-ink-400 dark:text-ink-300">[{i + 1}]</span>
						<Fragment set:html={paper.authors} />. <em class="font-display">{paper.title}.</em>
						<span class="text-ink-500 dark:text-ink-300"> {paper.status}. {paper.area}. <Fragment set:html={paper.description} /> </span>
						{paper.pdf && (
							<a href={paper.pdf} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors whitespace-nowrap">[PDF]</a>
						)}
					</li>
				))}
			</ol>
		</section>

		<hr class="border-rule dark:border-rule-dark" />

		<!-- ── 3. Talks & Presentations ── -->
		<section id="talks" class="py-12 scroll-mt-20">
			<h2 class="font-display text-2xl text-ink-900 dark:text-ink-100 mb-3">
				<span class="text-ink-400 dark:text-ink-300 mr-2">3.</span>Talks &amp; Presentations
			</h2>
			<p class="text-sm text-ink-400 dark:text-ink-300 italic mb-8">
				Talks marked with an asterisk (*) present papers authored by others, given as reading-group talks.
			</p>
			<div class="space-y-6">
				{talks.map((talk) => (
					<div class="grid md:grid-cols-[150px_1fr] gap-x-8 gap-y-1">
						<p class="text-xs tracking-wide text-ink-400 dark:text-ink-300 pt-1.5">{talk.date}</p>
						<div>
							<h3 class="font-display text-lg text-ink-900 dark:text-ink-100">
								{talk.title}{talk.readingGroup && <span class="text-ink-400 dark:text-ink-300"> *</span>}
							</h3>
							<p class="text-xs tracking-[0.08em] uppercase text-ink-400 dark:text-ink-300 mt-0.5">{talk.venue}</p>
							{talk.note && <p class="text-xs text-ink-400 dark:text-ink-300 italic mt-1">{talk.note}</p>}
							<p class="text-sm mt-1.5">
								<a href={talk.pdf} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">[Slides]</a>
							</p>
						</div>
					</div>
				))}
			</div>
		</section>

		<hr class="border-rule dark:border-rule-dark" />

		<!-- ── 4. Ongoing Work ── -->
		<section class="py-12">
			<h2 class="font-display text-2xl text-ink-900 dark:text-ink-100 mb-8">
				<span class="text-ink-400 dark:text-ink-300 mr-2">4.</span>Ongoing Work
			</h2>
			<div class="space-y-5 text-[15px] leading-[1.8]">
				{ongoing.map((item) => (
					<p>
						<strong class="font-semibold text-ink-900 dark:text-ink-100">{item.title}.</strong>
						{' '}<Fragment set:html={item.description} />
					</p>
				))}
			</div>
		</section>

	</div>
</Layout>
