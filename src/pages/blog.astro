---
import Layout from '../layouts/Layout.astro';

const posts = await Astro.glob('./posts/*.md');
const publishedPosts = posts.filter((p) => !p.frontmatter.draft && p.frontmatter.title);

---

<Layout title="Blog — Atishaya Maharjan" description="Writing on mathematics, algorithms, and software engineering.">
	<div class="max-w-5xl mx-auto px-6 py-16">

		<!-- Page header -->
		<div class="mb-16">
			<h1 class="font-cormorant text-5xl text-primary-900 dark:text-background-100 mb-4">Blog</h1>
			<p class="text-base text-primary-600 dark:text-background-400 font-body max-w-xl leading-relaxed">
				Writing on mathematics, algorithms, and software engineering. Occasional deep dives, research notes, and things worth documenting.
			</p>
		</div>

		<hr class="border-primary-100 dark:border-primary-300 mb-16" />

		{publishedPosts.length > 0 ? (
			<div class="space-y-12">
				{publishedPosts.map((post) => (
					<article>
						<div class="grid md:grid-cols-[160px_1fr] gap-6">
							<div class="text-xs tracking-wide text-primary-400 dark:text-background-600 font-body pt-1">
								{new Date(post.frontmatter.date).toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric' })}
							</div>
							<div>
								<h2 class="font-cormorant text-2xl text-primary-900 dark:text-background-100 mb-2">
									<a href={post.url} class="hover:text-tertiary-600 dark:hover:text-tertiary-400 transition-colors">
										{post.frontmatter.title}
									</a>
								</h2>
								{post.frontmatter.description && (
									<p class="text-sm text-primary-600 dark:text-background-500 font-body leading-relaxed mb-3">
										{post.frontmatter.description}
									</p>
								)}
								<a href={post.url} class="text-xs text-tertiary-600 dark:text-tertiary-400 hover:text-tertiary-800 dark:hover:text-tertiary-300 transition-colors font-body">
									Read more →
								</a>
							</div>
						</div>
					</article>
				))}
			</div>
		) : (
			<div class="py-24 text-center">
				<p class="font-cormorant text-2xl text-primary-400 dark:text-background-600 italic mb-4">Nothing here yet.</p>
				<p class="text-sm text-primary-400 dark:text-background-600 font-body max-w-md mx-auto leading-relaxed">
					Writing is coming soon — notes on mathematical research, algorithmic ideas, and occasionally, software. Check back later.
				</p>
			</div>
		)}

	</div>
</Layout>
