---
import Layout from '../layouts/Layout.astro';

const postModules = import.meta.glob<{ frontmatter: Record<string, any>; url: string }>('./posts/*.md', { eager: true });
const publishedPosts = Object.values(postModules)
	.filter((p) => !p.frontmatter.draft && p.frontmatter.title)
	.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<Layout title="Blog — Atishaya Maharjan" description="Writing on mathematics, algorithms, and software engineering.">
	<div class="max-w-3xl mx-auto px-6">

		<!-- Page header -->
		<header class="pt-20 pb-12 text-center">
			<h1 class="font-display font-medium text-4xl sm:text-5xl text-ink-900 dark:text-ink-100 mb-4">Blog</h1>
			<p class="text-base text-ink-500 dark:text-ink-300 max-w-xl mx-auto leading-relaxed">
				Writing on mathematics, algorithms, and software engineering. Occasional deep dives, research notes, and things worth documenting.
			</p>
		</header>

		<hr class="border-t-4 border-double border-ink-900 dark:border-ink-100" />

		{publishedPosts.length > 0 ? (
			<div class="py-12 space-y-10">
				{publishedPosts.map((post) => (
					<article class="grid md:grid-cols-[150px_1fr] gap-x-8 gap-y-1">
						<p class="text-xs tracking-wide text-ink-400 dark:text-ink-300 pt-1.5">
							{new Date(post.frontmatter.date).toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric' })}
						</p>
						<div>
							<h2 class="font-display text-2xl text-ink-900 dark:text-ink-100 mb-2">
								<a href={post.url} class="hover:text-accent-600 dark:hover:text-accent-300 transition-colors">
									{post.frontmatter.title}
								</a>
							</h2>
							{post.frontmatter.description && (
								<p class="text-sm text-ink-500 dark:text-ink-300 leading-relaxed mb-3">
									{post.frontmatter.description}
								</p>
							)}
							<a href={post.url} class="text-sm text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">
								Read more →
							</a>
						</div>
					</article>
				))}
			</div>
		) : (
			<div class="py-24 text-center">
				<p class="font-display text-2xl text-ink-400 dark:text-ink-300 italic mb-4">Nothing here yet.</p>
				<p class="text-sm text-ink-400 dark:text-ink-300 max-w-md mx-auto leading-relaxed">
					Writing is coming soon — notes on mathematical research, algorithmic ideas, and occasionally, software. Check back later.
				</p>
			</div>
		)}

	</div>
</Layout>
