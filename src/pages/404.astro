---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Atishaya Maharjan" description="Page not found.">
	<div class="max-w-5xl mx-auto px-6 py-32 text-center">
		<p class="font-cormorant text-8xl text-primary-200 dark:text-primary-800 mb-6">404</p>
		<h1 class="font-cormorant text-3xl text-primary-800 dark:text-background-200 mb-4">Page not found</h1>
		<p class="text-base text-primary-500 dark:text-background-500 font-body mb-10 max-w-sm mx-auto leading-relaxed">
			The page you're looking for doesn't exist or has been moved.
		</p>
		<a href="/" class="text-sm text-tertiary-600 dark:text-tertiary-400 hover:text-tertiary-800 dark:hover:text-tertiary-300 transition-colors font-body border border-tertiary-300 dark:border-tertiary-700 px-6 py-2">
			← Back to home
		</a>
	</div>
</Layout>
