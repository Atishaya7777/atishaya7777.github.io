---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Atishaya Maharjan" description="Page not found.">
	<div class="max-w-3xl mx-auto px-6 py-32 text-center">
		<p class="font-display text-8xl text-ink-400 dark:text-ink-300 mb-6">404</p>
		<h1 class="font-display text-3xl text-ink-900 dark:text-ink-100 mb-4">Page not found</h1>
		<p class="text-base text-ink-500 dark:text-ink-300 mb-10 max-w-sm mx-auto leading-relaxed">
			The page you're looking for doesn't exist or has been moved.
		</p>
		<a href="/" class="text-sm text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors border border-rule-strong dark:border-rule-dark-strong px-6 py-2">
			← Back to home
		</a>
	</div>
</Layout>
