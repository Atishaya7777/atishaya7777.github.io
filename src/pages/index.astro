---
import Icon from '../components/Icon/Icon.astro';
import Layout from '../layouts/Layout.astro';
import Seal from '../components/Seal/Seal.astro';
import routes from '../global/routes';
import { people, groups, refs } from '../global/people';

const structuredData = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Atishaya Maharjan",
	url: "https://atishaya7777.github.io",
	email: "mailto:atishaya7777@gmail.com",
	jobTitle: "Software Engineer & Researcher",
	affiliation: {
		"@type": "CollegeOrUniversity",
		name: "University of Manitoba",
	},
	worksFor: [
		{
			"@type": "Organization",
			name: "LG Electronics",
		},
		{
			"@type": "Organization",
			name: "Vibecore",
			url: "https://vibecore.cx/",
		},
	],
	sameAs: [
		"https://github.com/Atishaya7777",
		"https://www.linkedin.com/in/atishaya-maharjan07",
	],
	knowsAbout: [
		"Algorithms",
		"Computational Geometry",
		"Combinatorial Optimization",
		"Combinatorics",
		"Machine Learning",
		"Software Engineering",
	],
};

const contents = [
	{ marker: 'I', href: '#research-interests', title: 'Research Interests', detail: 'Algorithms, geometry, optimization, and learning under uncertainty' },
	{ marker: 'II', href: '#education', title: 'Education', detail: 'Joint Honours study and academic distinctions' },
	{ marker: 'III', href: '#experience', title: 'Experience', detail: 'Software engineering and research appointments' },
	{ marker: 'IV', href: '#papers', title: 'Preprints & Working Papers', detail: 'Current mathematical writing and manuscripts' },
	{ marker: 'V', href: '#selected-works', title: 'Selected Works', detail: 'Award-winning products and technical projects' },
	{ marker: 'VI', href: '#service', title: 'Teaching & Service', detail: 'Mentorship, instruction, and community work' },
];
---

<Layout
	title="Atishaya Maharjan — Computer Science & Mathematics"
	description="Computer Science & Mathematics student, researcher, and software engineer at the University of Manitoba."
	imageAlt="Title card reading: Atishaya Maharjan — Computer Science & Mathematics, University of Manitoba"
	structuredData={structuredData}
>

	<article class="max-w-4xl mx-auto px-6">

		<!-- ── Title block ── -->
		<header class="pt-12 pb-10 text-center">
			<div class="flex justify-center mb-5">
				<Seal class="w-12 h-12 text-ink-500 dark:text-ink-300" />
			</div>
			<p class="text-xs tracking-[0.25em] uppercase text-ink-400 dark:text-ink-300 mb-6">
				Curriculum Vitæ
			</p>

			<h1 class="font-display font-medium text-5xl sm:text-6xl text-ink-900 dark:text-ink-100 leading-tight mb-4">
				Atishaya Maharjan
			</h1>

			<p class="text-base text-ink-500 dark:text-ink-300 leading-relaxed mb-1">
				BSc. Joint Honours, Computer Science &amp; Mathematics · University of Manitoba
			</p>
			<p class="text-base text-ink-500 dark:text-ink-300 leading-relaxed mb-6">
				Software Engineer, LG Electronics · Tech Lead, Vibecore
			</p>

			<nav class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm" aria-label="Profile links">
				<a href="/assets/atishaya_research_resume.pdf" target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Research&nbsp;CV&nbsp;[PDF]</a>
				<span class="text-ink-400 dark:text-ink-300" aria-hidden="true">·</span>
				<a href="/assets/atishaya_swe_resume.pdf" target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Industry&nbsp;Résumé&nbsp;[PDF]</a>
				<span class="text-ink-400 dark:text-ink-300" aria-hidden="true">·</span>
				<a href="mailto:atishaya7777@gmail.com" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Email</a>
				<span class="text-ink-400 dark:text-ink-300" aria-hidden="true">·</span>
				<a href="https://github.com/Atishaya7777" target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">GitHub</a>
				<span class="text-ink-400 dark:text-ink-300" aria-hidden="true">·</span>
				<a href="https://www.linkedin.com/in/atishaya-maharjan07" target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">LinkedIn</a>
			</nav>

			<p class="text-xs tracking-[0.15em] uppercase text-ink-400 dark:text-ink-300 mt-6">
				Winnipeg, Canada
			</p>
		</header>

		<!-- Double rule, in the manner of a paper's title block -->
		<hr class="border-t-4 border-double border-ink-900 dark:border-ink-100" />

		<!-- ── Abstract ── -->
		<section class="py-10">
			<h2 class="text-center text-sm tracking-[0.2em] uppercase text-ink-900 dark:text-ink-100 font-semibold mb-5">Abstract</h2>
			<div class="space-y-4 text-[15px] leading-[1.75] max-w-2xl mx-auto">
				<p>
					I am a final-year student in Computer Science and Mathematics (Joint Honours, minor in Statistics) at the
					University of Manitoba. My research starts from algorithms and mathematical structure: exact and
					approximation algorithms and hardness results for geometric optimization problems, and combinatorics on
					trees. I am increasingly interested in optimization and learning under uncertainty, and in machine
					learning that rests on solid theory. In the
					<a href={groups.gada.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">GADA Lab</a>, I work with
					<a href={people.durocher.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Dr. Stephane Durocher</a> and
					<a href={people.naredla.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Dr. Anurag Murty Naredla</a> on fuel-efficient collaborative
					delivery; my honours project with <a href={people.henry.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Dr. Christopher Henry</a> is on
					calibrated risk prediction. On the engineering side, I am a software engineer at LG Electronics and
					tech lead at Vibecore.
				</p>
			</div>
		</section>

		<hr class="border-rule dark:border-rule-dark" />

		<!-- ── Contents ── -->
		<nav class="py-10" aria-labelledby="contents-title">
			<div class="grid md:grid-cols-[150px_minmax(0,1fr)] gap-8 md:gap-12 items-start">
				<header>
					<h2 id="contents-title" class="text-sm tracking-[0.2em] uppercase text-ink-900 dark:text-ink-100 font-semibold">Contents</h2>
					<p class="mt-3 text-xs leading-relaxed text-ink-400 dark:text-ink-300">
						A concise register of this curriculum vitæ.
					</p>
				</header>

				<div>
					<ol class="border-t border-rule-strong dark:border-rule-dark-strong list-none">
						{contents.map((item) => (
							<li class="border-b border-rule dark:border-rule-dark">
								<a href={item.href} class="group grid grid-cols-[2.5rem_minmax(0,1fr)_auto] gap-3 sm:gap-5 items-baseline py-3.5">
									<span class="font-mono text-[11px] tracking-[0.1em] text-ink-400 dark:text-ink-300">{item.marker}</span>
									<span class="min-w-0">
										<span class="block font-display text-lg leading-tight text-ink-900 dark:text-ink-100 group-hover:text-accent-700 dark:group-hover:text-accent-200 transition-colors">{item.title}</span>
										<span class="block mt-1 text-xs leading-relaxed text-ink-400 dark:text-ink-300">{item.detail}</span>
									</span>
									<span aria-hidden="true" class="text-sm text-ink-400 dark:text-ink-300 group-hover:text-accent-600 dark:group-hover:text-accent-300 transition-colors"><Icon name="arrow-right" /></span>
								</a>
							</li>
						))}
					</ol>

					<div class="mt-5 grid sm:grid-cols-[2.5rem_minmax(0,1fr)] gap-3 sm:gap-5 items-baseline">
						<span class="font-mono text-[11px] tracking-[0.1em] uppercase text-ink-400 dark:text-ink-300">Ref.</span>
						<div class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
							<a href={routes.research} class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Research dossier</a>
							<a href={routes.blog} class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Notes</a>
							<a href="/assets/atishaya_research_resume.pdf" target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Research CV [PDF]</a>
							<a href="/assets/atishaya_swe_resume.pdf" target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Industry résumé [PDF]</a>
							<a href={routes.contact} class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Contact</a>
						</div>
					</div>
				</div>
			</div>
		</nav>

		<!-- ── 1. Research Interests ── -->
		<section id="research-interests" class="py-10 scroll-mt-20">
			<h2 class="flex items-center gap-4 font-display text-2xl text-ink-900 dark:text-ink-100 mb-8">
				<span class="w-8 shrink-0 font-mono text-[11px] tracking-[0.1em] text-ink-400 dark:text-ink-300">I</span>
				<span>Research Interests</span>
				<span class="h-px flex-1 bg-rule dark:bg-rule-dark" aria-hidden="true"></span>
			</h2>
			<div class="space-y-5 text-[15px] leading-[1.8]">
				<p>
					<strong class="font-semibold text-ink-900 dark:text-ink-100">Algorithms &amp; computational geometry.</strong>
					Exact and approximation algorithms, and NP-hardness, for geometric problems such as collaborative
					delivery and Hamiltonian paths in spatially embedded graphs.
				</p>
				<p>
					<strong class="font-semibold text-ink-900 dark:text-ink-100">Combinatorial optimization under uncertainty.</strong>
					Optimization and decision-making when inputs are uncertain; calibrated prediction that can be trusted
					downstream.
				</p>
				<p>
					<strong class="font-semibold text-ink-900 dark:text-ink-100">Theoretically grounded machine learning.</strong>
					Learning methods with provable guarantees, including learning on graphs and hypergraphs.
				</p>
				<p>
					<strong class="font-semibold text-ink-900 dark:text-ink-100">Combinatorics.</strong>
					The Hurlbert–Kamat property and independence numbers of perfect trees, via generating functions.
				</p>
			</div>
		</section>

		<!-- ── 2. Education ── -->
		<section id="education" class="py-10 scroll-mt-20">
			<h2 class="flex items-center gap-4 font-display text-2xl text-ink-900 dark:text-ink-100 mb-8">
				<span class="w-8 shrink-0 font-mono text-[11px] tracking-[0.1em] text-ink-400 dark:text-ink-300">II</span>
				<span>Education</span>
				<span class="h-px flex-1 bg-rule dark:bg-rule-dark" aria-hidden="true"></span>
			</h2>
			<div class="grid md:grid-cols-[150px_1fr] gap-x-8 gap-y-2">
				<p class="text-xs tracking-wide text-ink-400 dark:text-ink-300 pt-1.5">Aug 2022 – May 2027 (expected)</p>
				<div>
					<h3 class="font-display text-xl text-ink-900 dark:text-ink-100">University of Manitoba</h3>
					<p class="text-sm text-ink-500 dark:text-ink-300 mt-0.5">
						BSc. Joint Honours — Computer Science &amp; Mathematics, Minor in Statistics
					</p>
					<p class="text-sm text-ink-500 dark:text-ink-300 mt-3 italic">
						International Undergraduate Scholarship · Dean's Honour Roll
					</p>
				</div>
			</div>
		</section>

		<!-- ── 3. Experience ── -->
		<section id="experience" class="py-10 scroll-mt-20">
			<h2 class="flex items-center gap-4 font-display text-2xl text-ink-900 dark:text-ink-100 mb-8">
				<span class="w-8 shrink-0 font-mono text-[11px] tracking-[0.1em] text-ink-400 dark:text-ink-300">III</span>
				<span>Experience</span>
				<span class="h-px flex-1 bg-rule dark:bg-rule-dark" aria-hidden="true"></span>
			</h2>
			<div class="space-y-8">
				<div class="grid md:grid-cols-[150px_1fr] gap-x-8 gap-y-1">
					<p class="text-xs tracking-wide text-ink-400 dark:text-ink-300 pt-1.5">Mar 2024 – Present</p>
					<div>
						<h3 class="font-display text-xl text-ink-900 dark:text-ink-100">LG Electronics</h3>
						<p class="text-sm text-ink-500 dark:text-ink-300">Software Engineer · Englewood Cliffs, USA (Remote)</p>
					<p class="text-sm text-ink-500 dark:text-ink-300 mt-2 leading-relaxed">
						Shipped Next.js, Redux, and TypeScript B2B platform features for 1,000+ vendors, contributing to a
						25% engagement lift. Built analytics adopted by 6+ teams and AI search with 35 ms lower latency;
						checkout workflows drove a 15% conversion lift.
						</p>
					</div>
				</div>

				<div class="grid md:grid-cols-[150px_1fr] gap-x-8 gap-y-1">
					<p class="text-xs tracking-wide text-ink-400 dark:text-ink-300 pt-1.5">Present</p>
					<div>
						<h3 class="font-display text-xl text-ink-900 dark:text-ink-100">Vibecore</h3>
						<p class="text-sm text-ink-500 dark:text-ink-300">Tech Lead · Remote</p>
					<p class="text-sm text-ink-500 dark:text-ink-300 mt-2 leading-relaxed">
						Lead a small team building a GitHub-native software verification platform for founders who build with
						AI coding tools. Automated CI/CD deployments from GitHub Actions to AWS EC2; configured S3, DynamoDB, IAM
						permissions, and EBS/EFS storage for cloud-hosted application workflows.
						</p>
					</div>
				</div>

				<div class="grid md:grid-cols-[150px_1fr] gap-x-8 gap-y-1">
					<p class="text-xs tracking-wide text-ink-400 dark:text-ink-300 pt-1.5">Jun 2025 – Jan 2026</p>
					<div>
						<h3 class="font-display text-xl text-ink-900 dark:text-ink-100">Hoek Insights</h3>
						<p class="text-sm text-ink-500 dark:text-ink-300">Software Engineer · Amsterdam, Netherlands (Remote)</p>
					<p class="text-sm text-ink-500 dark:text-ink-300 mt-2 leading-relaxed">
						Engineered a Python package for Three.js visualizations in Jupyter, reducing render time by 38% and
						bundle size by 25%. Shipped a FastAPI and PostgreSQL MVP with 18+ endpoints, below 200 ms staging
						latency, and 95% integration-test coverage.
						</p>
					</div>
				</div>

				<div class="grid md:grid-cols-[150px_1fr] gap-x-8 gap-y-1">
					<p class="text-xs tracking-wide text-ink-400 dark:text-ink-300 pt-1.5">Mar 2024 – Present</p>
					<div>
						<h3 class="font-display text-xl text-ink-900 dark:text-ink-100"><a href={groups.gada.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent-700 dark:hover:text-accent-200 transition-colors">GADA Lab</a></h3>
						<p class="text-sm text-ink-500 dark:text-ink-300">Undergraduate Researcher, Algorithms &amp; Computational Geometry · University of Manitoba</p>
						<p class="text-sm text-ink-500 dark:text-ink-300">
							Supervisors: <a href={people.durocher.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Dr. Stephane Durocher</a>,
							<a href={people.naredla.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Dr. Anurag Murty Naredla</a>,
							<a href={people.zhu.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Dr. Leqi (Jimmy) Zhu</a> &amp;
							<a href={people.miller.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Dr. Avery Miller</a>
						</p>
					<p class="text-sm text-ink-500 dark:text-ink-300 mt-2 leading-relaxed">
						Fuel-efficient collaborative delivery: an O(n²) algorithm for the line-restricted setting (improving the
						previous O(n³) from <a href={refs.walcom2025.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">WALCOM 2025</a>), an O(n³) algorithm for the
						L1 setting, and NP-hardness for the Euclidean setting, where the L1 algorithm gives a √2-approximation.
						Also built Hamiltonian-path approximation and randomized testing tooling across 100+ instances.
						</p>
					</div>
				</div>

				<div class="grid md:grid-cols-[150px_1fr] gap-x-8 gap-y-1">
					<p class="text-xs tracking-wide text-ink-400 dark:text-ink-300 pt-1.5">Sep 2026 – Apr 2027</p>
					<div>
						<h3 class="font-display text-xl text-ink-900 dark:text-ink-100">Honours Research Project</h3>
						<p class="text-sm text-ink-500 dark:text-ink-300">Calibrated Risk Prediction · University of Manitoba</p>
						<p class="text-sm text-ink-500 dark:text-ink-300">
							Supervisors: <a href={people.henry.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Dr. Christopher Henry</a>,
							<a href={people.sayari.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Dr. Mohammad Sayari</a> &amp;
							<a href={people.salehkalaibar.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Dr. Sadaf Salehkalaibar</a>
						</p>
					<p class="text-sm text-ink-500 dark:text-ink-300 mt-2 leading-relaxed">
						Calibrated prediction of potato pathogen risk and yield loss, in collaboration with the Department of
						Plant Science.
						</p>
					</div>
				</div>

				<div class="grid md:grid-cols-[150px_1fr] gap-x-8 gap-y-1">
					<p class="text-xs tracking-wide text-ink-400 dark:text-ink-300 pt-1.5">May 2025 – Present</p>
					<div>
						<h3 class="font-display text-xl text-ink-900 dark:text-ink-100">Terrabyte ML Research Group</h3>
						<p class="text-sm text-ink-500 dark:text-ink-300">Machine Learning Researcher · University of Manitoba</p>
					<p class="text-sm text-ink-500 dark:text-ink-300 mt-2 leading-relaxed">
						Extended diffusion-based learning to hypergraphs with PyTorch and PyTorch Geometric. Implemented 4
						model variants and built an MLflow pipeline tracking 25+ experiments across 5+ datasets.
						</p>
					</div>
				</div>
			</div>
			<p class="mt-8 text-sm">
				<a href={routes.works} class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">Full history<Icon name="arrow-right" class="ml-[0.2em]" /></a>
			</p>
		</section>

		<!-- ── 4. Preprints & Working Papers ── -->
		<section id="papers" class="py-10 scroll-mt-20">
			<h2 class="flex items-center gap-4 font-display text-2xl text-ink-900 dark:text-ink-100 mb-8">
				<span class="w-8 shrink-0 font-mono text-[11px] tracking-[0.1em] text-ink-400 dark:text-ink-300">IV</span>
				<span>Preprints &amp; Working Papers</span>
				<span class="h-px flex-1 bg-rule dark:bg-rule-dark" aria-hidden="true"></span>
			</h2>
			<ol class="space-y-6 text-[15px] leading-[1.8] list-none">
				<li class="pl-8 relative">
					<span class="absolute left-0 text-ink-400 dark:text-ink-300">[1]</span>
					<a href={people.durocher.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">S. Durocher</a>,
					<strong class="font-semibold text-ink-900 dark:text-ink-100">A. Maharjan</strong>,
					<a href={people.miller.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">A. Miller</a>,
					<a href={people.naredla.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">A. M. Naredla</a>.
					<em class="font-display">Geometric Algorithms and Hardness for Fuel-Efficient Collaborative Delivery.</em>
					Manuscript in preparation. O(n²) and O(n³) algorithms for the line-restricted and L1 settings, and
					NP-hardness for the Euclidean setting.
				</li>
				<li class="pl-8 relative">
					<span class="absolute left-0 text-ink-400 dark:text-ink-300">[2]</span>
					<a href={people.arman.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">A. Arman</a>,
					<strong class="font-semibold text-ink-900 dark:text-ink-100">A. Maharjan</strong>,
					<a href={people.shirazi.url} target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors">M. N. Shirazi</a>.
					<em class="font-display">HK Property in Perfect Binary Trees.</em>
					Preprint. A generating-function framework for star sizes in perfect m-ary trees, giving an alternate,
					coefficientwise proof of the HK-property, a structured recurrence for the gap between the leaf star and the
					root star, and formulas for the independence number and the minimum size of a maximal independent set.
					<a href="/assets/hk_perfect_binary_trees.pdf" target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 transition-colors whitespace-nowrap">[PDF]</a>
				</li>
				<li class="pl-8 relative">
					<span class="absolute left-0 text-ink-400 dark:text-ink-300">[3]</span>
					<strong class="font-semibold text-ink-900 dark:text-ink-100">A. Maharjan</strong>. <em class="font-display">Wiener Index.</em>
					Report. Implementation of a heuristic algorithm for an open problem on the Wiener index (the sum of all
